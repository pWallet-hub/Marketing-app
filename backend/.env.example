# Copy to .env (or set these in Coolify). Never commit real values.
DATABASE_URL=postgresql://marketing:change-me@db:5432/marketing
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_HTTPS_ONLY=true

KEYCLOAK_PUBLIC_URL=https://sso.afs-rwanda.org
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=afs

# The client is registered by the hub's keycloak bootstrap once the marketing application is added there.
OIDC_CLIENT_ID=marketing
OIDC_CLIENT_SECRET=
PUBLIC_BASE_URL=https://marketing-api.example.org
FRONTEND_ORIGIN=https://marketing.example.org

# The AFS hub backend, reached on the shared Docker network.
COMMAND_CENTER_URL=http://backend:8000
AFS_SERVICE_TOKEN_MARKETING=
