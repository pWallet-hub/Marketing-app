# Variables for docker-compose.yml. Never commit real values.
#   Production: set these in Coolify (Docker Compose build pack, compose file /docker-compose.yml).
#   Local: copy this file to .env (gitignored) and also set the "Local only" block at the bottom.
# Required unless marked optional. Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=change-me
SESSION_SECRET=replace-with-at-least-32-random-characters

# This app's single public address: the frontend serves the app and proxies /api to the backend.
# The SSO callback is PUBLIC_BASE_URL/api/auth/callback; set MARKETING_REDIRECT_URI in Command Center to exactly that.
PUBLIC_BASE_URL=https://marketing.afs-rwanda.org

# AFS SSO. The client "marketing" is created by Command Center's keycloak-init once MARKETING_OIDC_CLIENT_SECRET is
# set there; use the same secret here.
OIDC_CLIENT_ID=marketing
OIDC_CLIENT_SECRET=
# Required: the same value as KEYCLOAK_PUBLIC_URL in Command Center (no trailing /realms/afs).
KEYCLOAK_PUBLIC_URL=
# Optional, defaults shown. The internal addresses are on the shared afs-internal network.
# KEYCLOAK_INTERNAL_URL=http://afs-keycloak:8080
# KEYCLOAK_REALM=afs
# COMMAND_CENTER_URL=http://afs-command-center-backend:8000

# Same value as AFS_SERVICE_TOKEN_MARKETING in Command Center.
AFS_SERVICE_TOKEN_MARKETING=

# Mail through Resend (optional; without a key nothing is sent). Bare address; the name is RESEND_FROM_NAME.
# Use a sending subdomain separate from the hub's transactional mail (DESIGN.md).
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_NAME=AFS
RESEND_WEBHOOK_SECRET=

# Branding in every email. Optional; defaults shown. Set ORG_ADDRESS: a postal address belongs in marketing email.
# ORG_NAME=Alliance for Science Rwanda
# ORG_ADDRESS=
# ORG_WEBSITE=https://afs-rwanda.org
# BRAND_COLOR=#1f5fbf

# Optional integrations.
BIOCAP_ACCOUNT_URL=
BIOCAP_ACCOUNT_TOKEN=
FORM_TARGET_URL=
FORM_TARGET_TOKEN=

# Public pages (unsubscribe, forms). Optional, production defaults shown.
# TRUSTED_PROXY_HOPS is how many proxies append to X-Forwarded-For in front of the API: 2 on Coolify (Traefik, nginx).
# PUBLIC_RATE_LIMIT=30
# TRUSTED_PROXY_HOPS=2

# Retention in days. Optional; 0 keeps records. Expired form links are always removed 30 days after they expire.
# SEND_LOG_RETENTION_DAYS=0
# FORM_SUBMISSION_RETENTION_DAYS=0

# ---------------------------------------------------------------------------------------------------------------
# Local only. Leave all of this out of Coolify: the production defaults apply there.
# Start the local AFS Command Center first (its network is joined below), then `docker compose up -d --build`.
# ENVIRONMENT=development
# SESSION_HTTPS_ONLY=false
# PUBLIC_BASE_URL=http://localhost:8200
# KEYCLOAK_PUBLIC_URL=http://localhost:8081
# AFS_NETWORK=afs-command-center_default
# KEYCLOAK_INTERNAL_URL=http://afs-command-center-keycloak-1:8080
# COMMAND_CENTER_URL=http://afs-command-center-backend-1:8000
# TRUSTED_PROXY_HOPS=1
# WEB_PORT=8200
# Mail goes to the fake Resend (recorded at http://127.0.0.1:8025/log, never delivered):
# COMPOSE_PROFILES=local
# RESEND_API_KEY=re_local_fake
# RESEND_FROM=news@afs-rwanda.local
# RESEND_API_BASE=http://fake-resend:8025
